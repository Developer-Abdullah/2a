DB_USER=platform_admin
DB_PASSWORD=change_me_strong_db_password
DB_NAME=platform_db
DB_DSN=postgres://platform_admin:change_me_strong_db_password@postgres:5432/platform_db?sslmode=disable
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=change_me_strong_minio_password
S3_REGION=us-east-1
S3_BUCKET=platform-vault
AES_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_PRIVATE_KEY_PEM="generate_a_p256_es256_private_key"
JWT_PUBLIC_KEY_PEM="generate_the_matching_p256_es256_public_key"
NEXT_PUBLIC_API_URL=http://localhost:8080
BACKEND_API_URL=http://admin-api:8081
NEXTAUTH_URL=http://localhost:3000

# --- Storefront (public customer store) ---
# Slug of the single store tenant the storefront serves (seeded as "store").
STORE_TENANT_SLUG=store
# Public URL of the storefront; used to build the payment provider return/callback URL.
STOREFRONT_URL=http://localhost:3001
# Storefront-only public vars live in storefront/.env.local (contact + payment display):
#   NEXT_PUBLIC_WHATSAPP (digits only), NEXT_PUBLIC_TELEGRAM (username, no @).
# Manual transfer numbers are configured in storefront/lib/payment.ts.
NEXTAUTH_SECRET=generate_at_least_32_random_bytes
CORS_ALLOWED_ORIGINS=http://localhost:3000
ADMIN_CORS_ALLOWED_ORIGINS=http://localhost:3000
APNS_KEY_ID=ABCD123456
APNS_TEAM_ID=XYZ9876543
APNS_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# --- Signing worker (optional overrides) ---
# ZSIGN_BINARY: path to the zsign binary (defaults to "zsign" on PATH; the signing image installs it)
ZSIGN_BINARY=
# SIGNING_WORK_DIR: base dir for per-job scratch space (defaults to the OS temp dir)
SIGNING_WORK_DIR=

# --- Email (SMTP) delivery of activation codes ---
# When SMTP_HOST is set, the notifier worker emails codes on order fulfillment; otherwise it just
# logs the delivery (codes still appear on the order page). Use port 587 (STARTTLS) — port 465
# (implicit TLS) is not supported by the standard client.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<app password>
#        (create an App Password at https://myaccount.google.com/apppasswords — not your login password).
# Brevo: SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_USER=<brevo login>, SMTP_PASS=<smtp key>.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# From address shown to customers. Defaults to SMTP_USER when blank (required as-is by Gmail).
SMTP_FROM=

# --- Billing ---
# Grace window (days) after subscription expiry during which distribution still works. Default 14.
GRACE_PERIOD_DAYS=14
# MyFatoorah (Kuwait/GCC). Use apitest.myfatoorah.com for the sandbox.
MYFATOORAH_API_TOKEN=
MYFATOORAH_WEBHOOK_SECRET=
MYFATOORAH_BASE_URL=https://api.myfatoorah.com
# Paymob (Egypt).
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_BASE_URL=https://accept.paymob.com
