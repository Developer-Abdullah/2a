# ── Double A — production environment ───────────────────────────────────────────────────────────
# Copy to `.env` on the server and fill every value. Generate the secrets + JWT keypair with
# `scripts/gen-secrets.sh`. NEVER commit the real .env.
#
# Run:  docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build

# --- Domains (behind Caddy; point A/AAAA records at this server) ---
STORE_DOMAIN=doublea.store
API_DOMAIN=api.doublea.store
ADMIN_DOMAIN=admin.doublea.store
ADMIN_API_DOMAIN=admin-api.doublea.store
ACME_EMAIL=you@example.com

# --- Single store ---
# Forces every request to resolve to this one store (webhooks + itms-services have no tenant header).
STORE_TENANT_SLUG=store
# Public storefront origin used for the payment return/redirect.
STOREFRONT_URL=https://doublea.store

# --- Database (generate a strong password) ---
DB_USER=platform_admin
DB_PASSWORD=__CHANGE_ME__
DB_NAME=platform_db
DB_DSN=postgres://platform_admin:__CHANGE_ME__@postgres:5432/platform_db?sslmode=disable

# --- Redis / object storage ---
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=__CHANGE_ME__
S3_REGION=us-east-1
S3_BUCKET=platform-vault
AES_ENCRYPTION_KEY=__64_HEX_CHARS__

# --- Auth (ES256 P-256 keypair — from gen-secrets.sh) ---
JWT_PRIVATE_KEY_PEM="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----"
JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
NEXTAUTH_SECRET=__32+_RANDOM_BYTES__

# --- CORS (the storefront talks to the API server-side, so only the admin origins are needed) ---
CORS_ALLOWED_ORIGINS=https://admin.doublea.store
ADMIN_CORS_ALLOWED_ORIGINS=https://admin.doublea.store

# --- Storefront contact links (baked at build time) ---
NEXT_PUBLIC_WHATSAPP=201557583049
NEXT_PUBLIC_TELEGRAM=mtjr_2a

# --- Email (SMTP) delivery of codes — see docs/email.md ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Billing ---
GRACE_PERIOD_DAYS=14
# MyFatoorah (Kuwait / KWD)
MYFATOORAH_API_TOKEN=
MYFATOORAH_WEBHOOK_SECRET=
MYFATOORAH_BASE_URL=https://api.myfatoorah.com
# Paymob (Egypt / EGP)
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_BASE_URL=https://accept.paymob.com

# --- APNs (push, optional) ---
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY_PEM=
